# RetroVaders Environment Configuration
# Copy this to .env and customize as needed

# Claude Code Task List ID (optional - for persistent task tracking across sessions)
# CLAUDE_TASK_LIST_ID=retrovaders-tasks

# Development mode settings
# RUST_BACKTRACE=1
# RUST_LOG=debug

# Game settings (these can also be in settings.json)
# RETROVADERS_SCALE=3
# RETROVADERS_FULLSCREEN=false
# RETROVADERS_CRT_EFFECTS=true
# RETROVADERS_STARTING_LIVES=3
